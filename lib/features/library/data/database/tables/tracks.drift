-- Tracks discovered in a music source.
--
-- `artwork_ref` is a content hash, never a file path: the artwork pipeline
-- (Phase 6) populates it and the UI resolves it through the artwork
-- repository, so a remote source can supply covers later.
CREATE TABLE tracks (
    id TEXT NOT NULL PRIMARY KEY,
    source_id TEXT NOT NULL,
    source_item_id TEXT NOT NULL,
    title TEXT NOT NULL,
    artist TEXT,
    album TEXT,
    track_number INTEGER,
    duration_ms INTEGER,
    artwork_ref TEXT,
    sample_rate_hz INTEGER,
    bitrate_kbps INTEGER,
    format TEXT,
    lyrics TEXT,
    date_added DATETIME NOT NULL DEFAULT (unixepoch()),
    UNIQUE (source_id, source_item_id)
) AS TrackRow;

-- Covers are resolved by hash, so all tracks of one album share one cache
-- entry. Added in schema version 2; older databases create it in the upgrade.
CREATE INDEX tracks_artwork_ref_idx ON tracks (artwork_ref);
